{
  "name": "@lightcode/pi",
  "version": "0.2.0",
  "description": "LightCode for the pi coding agent: shrinks recognized bash output (tests, builds, diffs, searches) and its own grep/find results before the model reads them, keeping the original in the session.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "lightcode",
    "context",
    "tokens"
  ],
  "homepage": "https://github.com/Zongwei9888/lightcode-plugins/tree/main/adapters/pi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zongwei9888/lightcode-plugins.git",
    "directory": "adapters/pi"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "exports": {
    ".": "./dist/extension.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/extension.js",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "LICENSE.rtk"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@lightcode/core": "workspace:*",
    "@lightcode/mechanisms": "workspace:*",
    "@lightcode/protocol": "workspace:*",
    "@lightcode/store": "workspace:*"
  }
}
