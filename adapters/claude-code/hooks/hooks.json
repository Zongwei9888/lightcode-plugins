{
  "description": "TokenWise: replace the output of recognized Bash commands with a smaller projection (in bypassPermissions mode, run them through `tokenwise run`); after a compaction, add the catalog of tool results TokenWise kept recallable. At startup, say so if the tokenwise command is missing.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "tokenwise hook claude",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_tokenwise_tokenwise__tokenwise_recall",
        "hooks": [
          {
            "type": "command",
            "command": "tokenwise hook claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "tokenwise hook claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tokenwise hook claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "command -v tokenwise >/dev/null 2>&1 || echo '{\"systemMessage\":\"TokenWise: the tokenwise command is not on PATH, so the plugin does nothing yet. Install it: https://github.com/Zongwei9888/tokenwise#install\"}'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "tokenwise hook claude",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
