{
  "description": "LightCode: replace the model's copy of recognized shell results with a smaller projection; after a compaction, add the catalog of tool results LightCode kept recallable with the next tool result.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lc hook grok",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lc hook grok",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lc hook grok",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
