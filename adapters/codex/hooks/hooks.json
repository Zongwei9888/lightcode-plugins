{
  "description": "TokenWise: wrap recognizable shell commands in `tokenwise run` so their output is filtered before the model sees it; after a compaction, add the catalog of tool results TokenWise kept recallable.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "tokenwise hook codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "tokenwise hook codex",
            "timeout": 60,
            "additionalContextLimit": 6000
          }
        ]
      }
    ]
  }
}
